+def _local_or_hub_file(repo_id: str, filename: str) -> str:
+  """Resolve an installed snapshot path without a Hugging Face network lookup."""
+  local_repo = Path(repo_id)
+  if local_repo.is_dir():
+    candidate = local_repo / filename
+    if not candidate.is_file():
+      raise EntryNotFoundError(f"file is not present in local snapshot: {candidate}")
+    return str(candidate)
+  return hf_hub_download(repo_id=repo_id, filename=filename)
+
+
+def _component_source(repo_id: str, subfolder: str | None) -> tuple[str, dict]:
+  """Return a Transformers source plus kwargs for hub or installed layouts."""
+  local_repo = Path(repo_id)
+  if local_repo.is_dir():
+    source = local_repo / subfolder if subfolder else local_repo
+    return str(source), {"local_files_only": True}
+  return repo_id, ({"subfolder": subfolder} if subfolder else {})
+
+
