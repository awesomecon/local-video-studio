{
  "1": {
    "class_type": "Ideogram4PipelineLoader",
    "inputs": {
      "model_weights": "4.0 NF4"
    }
  },
  "2": {
    "class_type": "Ideogram4Generate",
    "inputs": {
      "pipeline": ["1", 0],
      "prompt": "{{prompt_json}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "sampler_preset": "4.0 Default 20",
      "num_steps": 20,
      "guidance_scale": 7.0,
      "mu": 0.0,
      "std": 1.75,
      "seed": "{{seed}}"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["2", 0],
      "filename_prefix": "local-video-studio/ideogram4-nf4"
    }
  }
}
