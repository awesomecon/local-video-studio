# Copy to .env only if you explicitly choose file-based secret loading.
# Never commit the real value.
LOCAL_LLM_API_KEY=replace_me
LOCAL_VIDEO_STUDIO_MOCK_MODE=1
# Optional: Google AI Studio key for the remote Gemini TTS provider.
# You can also save a key from the Voice page (stored in a private 0600
# file); an environment variable always takes precedence.
GEMINI_API_KEY=replace_me
